<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weave.auth.mapper.AuthMapper">

    <resultMap id="userDetailsResult" type="com.weave.auth.model.dto.CustomUserDetails">
        <id property="userId" column="userId"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <collection property="roles" column="userId" select="selectRoleNames" ofType="java.lang.String"/>
        <collection property="authorities" column="userId" select="selectPermissionNames" ofType="java.lang.String"/>
    </resultMap>

    <select id="selectRoleNames" resultType="java.lang.String">
        SELECT DISTINCT r.name
        FROM user_roles ur
        LEFT JOIN roles r ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
        AND r.name IS NOT NULL
    </select>

    <select id="selectPermissionNames" resultType="java.lang.String">
        SELECT DISTINCT p.name
        FROM user_roles ur
        LEFT JOIN role_permissions rp ON ur.role_id = rp.role_id
        LEFT JOIN permissions p ON rp.permission_id = p.id
        WHERE ur.user_id = #{userId}
        AND p.name IS NOT NULL
    </select>

    <select id="selectUserDetailsByEmail" resultMap="userDetailsResult">
        SELECT
            u.id as userId,
            u.email as username,
            u.password
        FROM users u
        WHERE u.email = #{email}
    </select>

</mapper>